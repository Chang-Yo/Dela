{
  "name": "dela",
  "version": "1.0.1",
  "private": true,
  "description": "A local-first campus project workspace",
  "author": "Dela contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "version:bump": "npm version --no-git-tag-version",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json",
    "build": "pnpm typecheck && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "build:helper": "node scripts/build-helper.mjs",
    "build:native": "node scripts/build-native.mjs",
    "start": "electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src scripts",
    "test": "vitest run --passWithNoTests",
    "test:remote": "vitest run --config vitest.remote.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "postinstall": "install-electron",
    "package:dir": "pnpm build && pnpm build:native && electron-builder --dir",
    "package:dist": "pnpm build && pnpm build:native && electron-builder",
    "smoke": "electron . --smoke-test",
    "smoke:workspace": "node scripts/workspace-smoke.mjs",
    "smoke:pdf": "electron scripts/pdf-smoke.cjs",
    "smoke:shuiyuan": "electron scripts/shuiyuan-smoke.cjs",
    "smoke:remote": "node scripts/remote-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@lezer/highlight": "1.2.3",
    "@mdream/js": "2.0.1",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@napi-rs/canvas": "1.0.9",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "docx-preview": "0.4.1",
    "framer-motion": "13.2.0",
    "gemoji": "8.1.0",
    "glimm": "0.3.1",
    "highlight.js": "11.12.0",
    "iconoir-react": "7.12.1",
    "imapflow": "2.0.0",
    "katex": "0.16.47",
    "liveline": "0.0.7",
    "lucide-react": "1.44.0",
    "node-pty": "1.1.0",
    "nodemailer": "10.0.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "streamdown": "2.6.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.9.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.0",
    "node-gyp": "12.4.0",
    "oxlint": "1.82.0",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
