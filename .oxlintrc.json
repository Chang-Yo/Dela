{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react"],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "off",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/use-memo": "off"
  },
  "overrides": [
    {
      "files": ["src/{core,modules,sjtu,ui,app}/**"],
      "rules": {
        "react/set-state-in-effect": "error",
        "react/refs": "error"
      }
    },
    {
      "files": ["src/{core,modules,app}/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/modules/*/main/**", "**/modules/*/view/*", "**/modules/*/data/**"],
                "message": "模块之间只通过对方的 index.ts、contract.ts 或 view/index.ts 引用。"
              },
              {
                "group": ["**/sjtu/**"],
                "message": "只有 app/modules.ts 可以引用交大模块：通用模块需要交大数据时开注册口。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "electron",
                  "electron/**",
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**"
                ],
                "message": "core 只依赖 Pi 与 Node（docs/adr/0001、0013）：宿主能力经端口注入，界面在模块的 view/ 里。"
              },
              {
                "group": [
                  "**/main",
                  "**/main/**",
                  "**/preload/**",
                  "**/renderer/**",
                  "**/shared/**",
                  "**/app/**",
                  "**/modules/**",
                  "**/ui/**"
                ],
                "message": "core 不认识具体业务（docs/adr/0014）：在 core/capabilities 开注册表，由模块注册进来。"
              },
              {
                "group": ["**/sjtu/**"],
                "message": "只有 app/modules.ts 可以引用交大模块：通用模块需要交大数据时开注册口。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/core/protocol/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "**", "!zod", "!./*"],
                "message": "core/protocol 只依赖 zod：桌面 React 与移动端共用协议，不能带入 core 其他部分或宿主依赖。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/modules/*/main/**", "**/modules/*/view/*", "**/modules/*/data/**"],
                "message": "模块之间只通过对方的 index.ts、contract.ts 或 view/index.ts 引用。"
              },
              {
                "group": ["**/sjtu/**"],
                "message": "只有 app/modules.ts 可以引用交大模块：通用模块需要交大数据时开注册口。"
              },
              {
                "group": ["**/app/*", "!**/app/module"],
                "message": "模块只能引用 app/module.ts。"
              },
              {
                "group": [
                  "../../main/**",
                  "../../../main/**",
                  "../../../../main/**",
                  "../../preload/**",
                  "../../../preload/**",
                  "../../../../preload/**"
                ],
                "message": "模块不能引用旧主进程与 preload 的内部实现。"
              },
              {
                "group": [
                  "../*/main/**",
                  "../*/data/**",
                  "../*/view",
                  "../*/view/**",
                  "../../*/main/**",
                  "../../*/data/**",
                  "../../*/view",
                  "../../*/view/**",
                  "./view",
                  "./view/**",
                  "../view",
                  "../view/**"
                ],
                "message": "模块之间只通过对方的 index.ts 或 contract.ts 引用；主进程侧不能引用 view。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/*/view/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/modules/*/main/**", "**/modules/*/view/*", "**/modules/*/data/**"],
                "message": "模块之间只通过对方的 index.ts、contract.ts 或 view/index.ts 引用。"
              },
              {
                "group": ["**/sjtu/**"],
                "message": "只有 app/modules.ts 可以引用交大模块：通用模块需要交大数据时开注册口。"
              },
              {
                "group": ["**/core/*", "!**/core/protocol", "**/core/*/**", "!**/core/protocol/**"],
                "message": "view 只能引用 core/protocol。"
              },
              {
                "group": [
                  "**/app/**",
                  "../../main/**",
                  "../../../main/**",
                  "../../../../main/**",
                  "../../preload/**",
                  "../../../preload/**",
                  "../../../../preload/**",
                  "**/modules/*/index",
                  "**/modules/*",
                  "!**/modules/*/contract",
                  "**/shared/**",
                  "**/renderer/**",
                  "!**/renderer/components/ui/**",
                  "!**/renderer/lib/utils"
                ],
                "message": "view 只能引用 core/protocol、模块契约与 ui（过渡期允许 renderer/components/ui 与 lib/utils）。"
              },
              {
                "group": [
                  "..",
                  "../index",
                  "../main/**",
                  "../data/**",
                  "../../main/**",
                  "../../*",
                  "../../*/index",
                  "../../*/main/**",
                  "../../*/data/**",
                  "../../*/view/*",
                  "@/**"
                ],
                "message": "view 不能引用本模块主进程侧，也只能经 contract.ts 或 view/index.ts 引用其他模块。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/{main,preload,renderer,shared}/**", "scripts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/modules/*/main/**", "**/modules/*/view/*", "**/modules/*/data/**"],
                "message": "模块之间只通过对方的 index.ts、contract.ts 或 view/index.ts 引用。"
              },
              {
                "group": ["**/sjtu/**"],
                "message": "只有 app/modules.ts 可以引用交大模块：通用模块需要交大数据时开注册口。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main/{canvas,mail,shuiyuan,vsjtu,timetable,todo,notifications}/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/modules/*/main/**", "**/modules/*/view/*", "**/modules/*/data/**"],
                "message": "模块之间只通过对方的 index.ts、contract.ts 或 view/index.ts 引用。"
              },
              {
                "group": ["**/sjtu/**"],
                "message": "只有 app/modules.ts 可以引用交大模块：通用模块需要交大数据时开注册口。"
              },
              {
                "regex": "^(\\.\\./)+agent(/|$)",
                "message": "校园模块不能依赖 Agent 内核（docs/adr/0001、0005）：由内核通过注册表调用校园模块。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main/remotes/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/modules/*/main/**", "**/modules/*/view/*", "**/modules/*/data/**"],
                "message": "模块之间只通过对方的 index.ts、contract.ts 或 view/index.ts 引用。"
              },
              {
                "group": ["**/sjtu/**"],
                "message": "只有 app/modules.ts 可以引用交大模块：通用模块需要交大数据时开注册口。"
              },
              {
                "regex": "^(../)+agent(/|$)",
                "message": "远程执行后端不能依赖 Agent：只暴露 RemoteBackend，Pi 工具适配在 agent/remote-tools。"
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["src/renderer/components/ui/beautifului/**"]
}
