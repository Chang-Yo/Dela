{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/renderer/*"] },
    "resolveJsonModule": true
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "src/core/protocol/**/*.ts",
    "src/modules/*/contract.ts",
    "src/modules/*/view/**/*.ts",
    "src/modules/*/view/**/*.tsx"
  ]
}
