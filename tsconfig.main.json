{
  "extends": "./tsconfig.json",
  "compilerOptions": { "lib": ["ES2023"], "types": ["node"] },
  "include": [
    "src/core/**/*.ts",
    "src/app/**/*.ts",
    "src/modules/**/*.ts",
    "src/sjtu/**/*.ts",
    "vite.*.config.ts"
  ],
  // 测试夹具里的 Pi package 由 Pi 的 jiti 加载（typebox 等宿主模块经它的别名解析），不属于主进程源码。
  "exclude": [
    "src/app/main/**/test/fixtures/**",
    "src/app/views.ts",
    "src/app/renderer/**",
    "src/modules/*/view/**",
    "src/sjtu/*/view/**"
  ]
}
